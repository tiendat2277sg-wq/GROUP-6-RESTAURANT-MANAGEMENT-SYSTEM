{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "installCommand": "cd .. && npm ci",
      "buildCommand": "node ../scripts/build-vercel.mjs",
      "outputDirectory": "dist",
      "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
    },
    "backend": {
      "root": ".",
      "framework": "express",
      "entrypoint": "backend/src/index.js",
      "installCommand": "npm ci",
      "buildCommand": "node --version",
      "functions": {
        "backend/src/index.js": {
          "maxDuration": 300,
          "excludeFiles": "{frontend,dist,runtime,local-data,scratch,test-cases,database}/**"
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": { "service": "backend" } },
    { "source": "/socket.io/:path*", "destination": { "service": "backend" } },
    { "source": "/uploads/:path*", "destination": { "service": "backend" } },
    { "source": "/health", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ],
  "crons": [{ "path": "/api/cron/maintenance", "schedule": "* * * * *" }]
}
