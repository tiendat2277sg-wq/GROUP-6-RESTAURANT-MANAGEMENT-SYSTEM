{
  "name": "phurai-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:frontend": "cd frontend && vite --host 127.0.0.1",
    "dev:backend": "node backend/src/index.js",
    "dev:full": "concurrently --kill-others \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "cd frontend && vite build",
    "lint": "cd frontend && eslint src",
    "preview": "cd frontend && vite preview --host 127.0.0.1",
    "db:init": "node backend/src/run_master_schema.js",
    "db:init:prod": "node backend/src/run_master_schema.js --confirm",
    "db:init:local": "node backend/src/run_master_schema.js --confirm --seed-full",
    "db:seed": "node backend/scripts/inject_seed_to_sql.mjs",
    "start": "node backend/src/index.js",
    "check:local": "node scripts/verify-local.mjs",
    "build:vercel": "node scripts/build-vercel.mjs",
    "check:vercel": "node scripts/check-vercel.mjs"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "@vercel/blob": "^2.8.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "framer-motion": "^12.40.0",
    "gsap": "^3.15.0",
    "jsonwebtoken": "9.0.3",
    "lucide-react": "^1.18.0",
    "mssql": "^12.5.5",
    "multer": "^2.1.1",
    "mysql2": "^3.22.3",
    "nodemailer": "^9.0.1",
    "pdfmake": "^0.3.11",
    "prop-types": "^15.8.1",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "qs": "^6.15.2",
    "react": "^19.2.6",
    "react-date-range": "^2.0.1",
    "react-dom": "^19.2.6",
    "react-draggable": "^4.7.0",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^6.30.4",
    "react-toastify": "^11.1.0",
    "recharts": "^3.8.1",
    "redis": "^6.3.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "zod": "4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "concurrently": "^10.0.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "kill-port": "^2.0.1",
    "opentype.js": "^2.0.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "vercel": "^65.11.0",
    "vite": "^8.0.12"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "optionalDependencies": {
    "msnodesqlv8": "^6.2.2"
  }
}
