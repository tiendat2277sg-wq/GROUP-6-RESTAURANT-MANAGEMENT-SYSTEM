# Set these in Vercel Project Settings > Environment Variables.
# Do not copy the local Windows .env to Vercel.
NODE_ENV=production
APP_URL=https://your-project.vercel.app
DB_SERVER=your-sql-server.example.com
DB_PORT=1433
DB_DATABASE=System_Restaurant
DB_USER=your-app-user
DB_PASSWORD=
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false
JWT_SECRET=
CRON_SECRET=
# TCP/TLS Redis endpoint supporting pub/sub; NOT a REST URL/token.
REDIS_URL=rediss://default:password@host:6379
# Private Blob store linked to this project, or static token as fallback.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
# Optional real email for registration/password reset (no local mailbox on Vercel).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Optional integrations; leave blank if unused. Bank transfer UI remains disabled.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
GEMINI_API_KEY=
